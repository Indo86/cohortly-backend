# Copy to .env and fill in. Never commit .env.

# --- required -----------------------------------------------------------
# MongoDB connection string (e.g. a local instance or Atlas)
DATABASE_URL=mongodb://127.0.0.1:27017/lms
# Secret used to sign JWTs. At least 16 characters; use a long random value.
SECRET_KEY_JWT=
# Public base URL of THIS backend (used to build image URLs)
APP_URL=http://localhost:3000
# Public base URL of the frontend (CORS allow-list and Midtrans return page)
FRONTEND_URL=http://localhost:5173

# --- optional -----------------------------------------------------------
PORT=3000
# Comma-separated extra CORS origins (defaults to FRONTEND_URL)
# CORS_ORIGIN=
# Price of one subscription period in IDR
# SUBSCRIPTION_PRICE=280000
# Calendar months of access bought by one successful payment (integer 1-24, default 1).
# Manual renewal only: there is no automatic recurring charge.
# SUBSCRIPTION_PERIOD_MONTHS=1

# --- Midtrans (sign-up payments + webhook) --------------------------------
# Snap transactions endpoint, e.g. sandbox:
# https://app.sandbox.midtrans.com/snap/v1/transactions
MIDTRANS_URL=
# base64("<MIDTRANS_SERVER_KEY>:")  (note the trailing colon before encoding)
MIDTRANS_AUTH_STRING=
# Optional. If empty, the server key is derived from MIDTRANS_AUTH_STRING and is
# used to verify the signature of payment notifications.
# MIDTRANS_SERVER_KEY=
# Configure the notification URL in the Midtrans dashboard as:
#   <public backend URL>/api/handle-payment-midtrans

# --- seed script ----------------------------------------------------------
# Password for `npm run seed:demo` accounts (default: demo-password-123)
# DEMO_PASSWORD=

# --- AI assistance (optional, M9) ------------------------------------------
# Cohortly is a complete LMS with AI turned off. Leave AI_ENABLED=false (or the key empty) and
# the backend boots normally; the AI tools simply report "unavailable". The key is read ONLY here
# (never by the Vue app) and is never logged or sent to the browser.
AI_ENABLED=false
# openrouter (implemented). gemini is a recognised extension point that is not implemented yet.
AI_PROVIDER=openrouter
# openrouter/free lets OpenRouter pick a free model that supports the request.
AI_MODEL=openrouter/free
OPENROUTER_API_KEY=
# Provider timeout, 1000-120000 ms (default 20000), and max tokens of a reply, 100-4000 (default 1200)
# AI_TIMEOUT_MS=20000
# AI_MAX_OUTPUT_TOKENS=1200
# Usage protection (free tiers are small): cooldown between one user's AI requests, per-user cap
# per hour and a global cap per minute (kept below the provider's own limit)
# AI_USER_COOLDOWN_MS=3000
# AI_USER_MAX_PER_HOUR=30
# AI_GLOBAL_MAX_PER_MINUTE=15
